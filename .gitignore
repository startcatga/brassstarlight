#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing material & CI secrets — never commit these
**/key.properties
*.jks
*.keystore
**/starcart-keystore-base64.txt
*keystore-base64.txt
*_base64.txt
*base64*.txt

# --- Privacy scrub (game-launch Stage 3) -------------------------------------------
# Machine-specific paths (contain the local username / SDK locations)
**/local.properties
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ephemeral/
.flutter-plugins
# OS metadata
Thumbs.db
desktop.ini
ehthumbs.db
*.lnk
# Editor / assistant / tool config that may hold personal settings
.vscode/
.claude/
.cursor/
*.code-workspace
# Secrets and environment files
.env
.env.*
*.p12
*.pem
*.key
google-services.json
service-account*.json
# Python caches from tool/ scripts
__pycache__/
# Android build/tooling caches
**/android/.gradle/
**/android/captures/
**/android/app/.cxx/
*.hprof
# Platforms not built for Play (Android only). Remove these lines to ship them.
/windows/
/ios/
/linux/
/macos/

# Store listing assets (icons, screenshots) — kept locally, not pushed
/store/

# Local test/preview output
.playwright-mcp/
